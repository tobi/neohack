    "check": "node scripts/stage-validator.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vercel/routing-utils": "^6.5.0",
    "typescript": "^5.9.3",
    "vercel": "^50.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}
