{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neonethack.example/proto/schema_v0.json",
  "title": "neonethack protocol v0.1",
  "description": "JSON-RPC 2.0 NDJSON wire as implemented by upstream/win/headless. See PROTOCOL.md (normative) and vectors/*.jsonl (golden bytes).",
  "definitions": {
    "clientRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "integer" },
        "method": { "enum": ["initialize", "new_game"] },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "initializeParams": {
      "type": "object",
      "required": ["protocolVersion"],
      "properties": {
        "protocolVersion": { "type": "string", "pattern": "^0\\." }
      },
      "additionalProperties": true
    },
    "newGameParams": {
      "type": "object",
      "properties": {
        "role": { "type": "integer" },
        "race": { "type": "integer" },
        "gender": { "type": "integer" },
        "align": { "type": "integer" },
        "name": { "type": "string" },
        "seed": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "inputRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "integer" },
        "method": { "const": "input" },
        "params": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["key", "poskey", "yn", "getlin", "extcmd", "menu", "msgmenu", "ack"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "inputResult": {
      "type": "object",
      "properties": {
        "key": { "type": "integer" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "mod": { "type": "integer" },
        "answer": { "type": "string" },
        "line": { "type": "string" },
        "index": { "type": "integer" },
        "picks": { "type": "array", "items": { "type": "integer" } },
        "counts": { "type": "array", "items": { "type": "integer" } }
      },
      "additionalProperties": true
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": {
          "enum": ["window_create", "window_destroy", "window_clear",
                   "window_display", "cursor", "message", "status_init",
                   "status_enablefield", "status_update", "menu_start",
                   "menu_item", "menu_end", "snapshot", "map_delta",
                   "glyph", "cliparound", "positionbar", "bell", "delay",
                   "number_pad", "preference", "display_file",
                   "inventory", "session_ended"]
        },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "mapCell": {
      "type": "object",
      "required": ["x", "y", "glyph", "ttychar", "framecolor", "tileidx", "color256idx"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "glyph": { "type": "integer" },
        "ttychar": { "type": "integer" },
        "framecolor": { "type": "integer" },
        "tileidx": { "type": "integer" },
        "color256idx": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "errorObject": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "properties": {
    "jsonrpc": { "const": "2.0" }
  },
  "required": ["jsonrpc"]
}
