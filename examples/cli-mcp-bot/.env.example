# LLM endpoint configuration (copy to .env — git-ignored — and adjust).
# Any OpenAI-compatible endpoint works.

# Committed defaults: real OpenAI + gpt-5.6-luna.
# Local override example (vLLM on the tailnet):
#   OPENAI_API_BASE=https://llm.tail250b8.ts.net/v1
#   OPENAI_API_KEY=dummy
#   OPENAI_MODEL=current

OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna

# Optional engine/path overrides (defaults resolve from the repository layout):
# NEONETHACK_ROOT=/path/to/neohack
# NEONETHACK_ENGINE=/path/to/lib/neonethack/engine/playground/nethack
# NEONETHACK_DATA=/path/to/lib/neonethack/engine/playground
# NEONETHACK_EXECUTABLE=/path/to/lib/neonethack/build/native/neonethack
# NEONETHACK_SESSIONS=/path/to/sessions
# State directory (iterated doctrine/advisor/logs live here):
# NEONETHACK_BOT_STATE=/path/to/bot-state
# STEP_BUDGET=1000
