{
  "name": "neonethack-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "bun tools/build-client.ts",
    "build:component": "bun tools/build-component.ts",
    "test:component": "bun tools/test-component-browser.ts",
    "build:core": "bun tools/build-core.ts",
    "build:engine": "bun tools/build-engine.ts",
    "build": "bun run build:engine && bun run build:core && bun run build:client",
    "test": "bun test mcp/tests",
    "test:browser": "bun client/tests/browser.ts",
    "test:browser:renderer": "bun client/tests/renderer-browser.ts",
    "test:browser:inspection": "bun client/tests/inspection-browser.ts",
    "test:browser:terminal": "bun client/tests/terminal-browser.ts",
    "test:browser:scenarios": "bun client/tests/scenarios-browser.ts",
    "test:browser:recovery": "bun client/tests/recovery-browser.ts",
    "test:browser:storage": "bun client/tests/storage-browser.ts",
    "test:reconstruction-browser": "bun client/tests/reconstruction-browser.ts",
    "reconstruct": "bun tools/reconstruct-run.ts",
    "format": "prettier --write client/explorer-app.js client/explorer-theme.js client/nh-map3d.js client/recording.js client/world.js tools/*.ts mcp/src/runs.ts mcp/src/reconstruct.ts mcp/src/origin.ts mcp/tests/*.test.ts",
    "dev": "bun bun_server/src/index.ts"
  },
  "dependencies": {
    "lit": "3.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
