# Native static release; build dependencies never enter the installed artifact.
FROM docker.io/library/alpine:3.23
RUN apk add --no-cache build-base cmake ninja pkgconf curl linux-headers \
    libevent-dev libevent-static ncurses-dev ncurses-static \
    util-linux-dev util-linux-static musl-utils musl-dev
WORKDIR /src
COPY . .
RUN mkdir -p third_party && curl -fsSL https://www.lua.org/ftp/lua-5.4.9.tar.gz -o third_party/lua-5.4.9.tar.gz
ENV NEONETHACK_LDFLAGS=-static MUSL=1
ENV NEONETHACK_CFLAGS="-UGNU_LIBC -O2"
RUN cmake -S . -B build/bundle -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=OFF -DNNH_BUNDLE_MCP=ON -DNNH_STATIC_MCP=ON \
    -DNNH_BUNDLE_LICENSE_DIR=/src/scripts/bundle-licenses \
    && cmake --build build/bundle --target neonethack-mcp \
    && strip build/bundle/neonethack-mcp \
    && readelf -l build/bundle/neonethack-mcp > build/bundle/program-headers.txt \
    && awk '/INTERP/ { bad=1 } END { exit bad }' build/bundle/program-headers.txt \
    && readelf -l build/bundle/bundle/nethack > build/bundle/engine-headers.txt \
    && awk '/INTERP/ { bad=1 } END { exit bad }' build/bundle/engine-headers.txt
