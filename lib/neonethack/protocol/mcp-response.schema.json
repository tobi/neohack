{
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sessionId": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation": {
      "type": "object"
    },
    "operationId": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "historical": {
      "type": "boolean"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "compact"
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omittedClearTerrainEvents": {
          "type": "integer"
        },
        "fullObservation": {
          "const": "session_observe"
        },
        "attempts": {
          "const": "session_actions"
        },
        "fullInputReceipt": {
          "const": "receipt"
        }
      },
      "required": [
        "kind",
        "omitted",
        "omittedClearTerrainEvents",
        "fullObservation",
        "attempts"
      ],
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "snapshot",
            "delta"
          ]
        },
        "id": {
          "type": "integer"
        },
        "base": {
          "type": "integer"
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worldRemoved": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "decision": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outcome": {
      "type": "object"
    },
    "ended": {
      "type": "boolean"
    },
    "end": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
