{
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sessionId": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation": {
      "type": "object"
    },
    "operationId": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "historical": {
      "type": "boolean"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "compact"
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omittedClearTerrainEvents": {
          "type": "integer"
        },
        "fullObservation": {
          "const": "observe"
        },
        "attempts": {
          "const": "inspect"
        },
        "fullInputReceipt": {
          "const": "receipt"
        }
      },
      "required": [
        "kind",
        "omitted",
        "omittedClearTerrainEvents",
        "fullObservation",
        "attempts"
      ],
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "answer"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "decisionId": {
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "decisionId"
          ],
          "additionalProperties": false
        },
        "valueSchema": {
          "type": "object"
        },
        "instruction": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments",
        "valueSchema",
        "instruction"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "cancel"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "decisionId": {
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "decisionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "availability": {
            "type": "string",
            "enum": [
              "attemptable",
              "uncertain",
              "needsSelection"
            ]
          },
          "cost": {
            "const": "variable"
          }
        },
        "required": [
          "tool",
          "arguments",
          "availability",
          "cost"
        ],
        "additionalProperties": false
      }
    },
    "update": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "snapshot",
            "delta"
          ]
        },
        "id": {
          "type": "integer"
        },
        "base": {
          "type": "integer"
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worldRemoved": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "decision": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outcome": {
      "type": "object"
    },
    "ended": {
      "type": "boolean"
    },
    "end": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
