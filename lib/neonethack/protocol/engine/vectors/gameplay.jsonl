{"dir": "e2c", "line": {"jsonrpc": "2.0", "method": "message", "params": {"channel": "message", "window": 1, "attr": 0, "text": "[Crom has chosen you to recover the Amulet of Yendor for Him.]"}}}
{"dir": "e2c", "line": {"jsonrpc": "2.0", "method": "message", "params": {"channel": "message", "window": 1, "attr": 0, "text": "Hello vector, welcome to NetHack!  You are a neutral male human Barbarian."}}}
